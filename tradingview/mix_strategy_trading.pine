// =============================================================================
// Mix Strategy Trading System — Pine Script v6
// =============================================================================
// A Malik-inspired multi-signal consensus system that combines 5 sub-strategies
// and only trades when enough of them agree (voting threshold).
//
// Sub-Strategies:
//   S1: MA Crossover Trend    — MA(fast) vs MA(slow) for trend direction
//   S2: Bollinger Mean Revert — Buy lower band dips, sell upper band peaks
//   S3: RSI Momentum          — Oversold = buy, overbought = sell
//   S4: MACD Signal           — MACD line vs signal line crossovers
//   S5: Rate-of-Change Filter — Momentum acceleration/deceleration
//
// Consensus: Trade only when >= N sub-strategies agree on direction.
// Position sizing scales with conviction (how many strategies agree).
//
// Fully configurable: every parameter is an input you can tune.
// Works on any symbol (NDX, QQQ, AAPL, BTC, etc.) and any timeframe.
// =============================================================================

//@version=6
strategy("Mix Strategy Trading System",
     overlay=true,
     initial_capital=100000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.0,
     slippage=1,
     calc_on_every_tick=false,
     pyramiding=0)

// =============================================================================
// INPUTS — SUB-STRATEGY PARAMETERS (fully configurable)
// =============================================================================

// --- S1: MA Crossover ---
i_s1_enabled    = input.bool(true, "S1: MA Crossover Enabled", group="S1: MA Crossover")
i_s1_fast       = input.int(20, "Fast MA Period", minval=2, maxval=200, group="S1: MA Crossover")
i_s1_slow       = input.int(250, "Slow MA Period", minval=10, maxval=500, group="S1: MA Crossover")
i_s1_useEma     = input.bool(false, "Use EMA (vs SMA)", group="S1: MA Crossover")

// --- S2: Bollinger Bands ---
i_s2_enabled    = input.bool(true, "S2: Bollinger Bands Enabled", group="S2: Bollinger Bands")
i_s2_period     = input.int(20, "BB Period", minval=5, maxval=100, group="S2: Bollinger Bands")
i_s2_std        = input.float(2.0, "BB Std Dev", minval=0.5, maxval=4.0, step=0.1, group="S2: Bollinger Bands")
i_s2_buyPctB    = input.float(0.2, "Buy below %B", minval=0.0, maxval=0.5, step=0.05, group="S2: Bollinger Bands",
                     tooltip="Buy when %B drops below this level (mean reversion)")
i_s2_sellPctB   = input.float(0.8, "Sell above %B", minval=0.5, maxval=1.0, step=0.05, group="S2: Bollinger Bands",
                     tooltip="Sell when %B rises above this level")

// --- S3: RSI ---
i_s3_enabled    = input.bool(true, "S3: RSI Enabled", group="S3: RSI")
i_s3_period     = input.int(14, "RSI Period", minval=2, maxval=50, group="S3: RSI")
i_s3_oversold   = input.float(30.0, "Oversold Level", minval=10, maxval=50, group="S3: RSI")
i_s3_overbought = input.float(70.0, "Overbought Level", minval=50, maxval=90, group="S3: RSI")

// --- S4: MACD ---
i_s4_enabled    = input.bool(true, "S4: MACD Enabled", group="S4: MACD")
i_s4_fast       = input.int(12, "MACD Fast", minval=2, maxval=50, group="S4: MACD")
i_s4_slow       = input.int(26, "MACD Slow", minval=10, maxval=100, group="S4: MACD")
i_s4_signal     = input.int(9, "MACD Signal", minval=2, maxval=50, group="S4: MACD")

// --- S5: Rate of Change ---
i_s5_enabled    = input.bool(true, "S5: ROC Enabled", group="S5: Rate of Change")
i_s5_period     = input.int(20, "ROC Period", minval=2, maxval=100, group="S5: Rate of Change")
i_s5_buyThresh  = input.float(0.0, "ROC Buy Threshold (%)", minval=-20, maxval=20, step=0.5, group="S5: Rate of Change",
                     tooltip="Buy when ROC rises above this level")
i_s5_sellThresh = input.float(0.0, "ROC Sell Threshold (%)", minval=-20, maxval=20, step=0.5, group="S5: Rate of Change",
                     tooltip="Sell when ROC drops below this level")

// --- Consensus & Risk ---
i_minVotes      = input.int(3, "Min Votes to Trade", minval=1, maxval=5, group="Consensus",
                     tooltip="Minimum sub-strategies that must agree before entering a trade")
i_posScale      = input.bool(true, "Scale Position by Conviction", group="Consensus",
                     tooltip="Size position proportional to how many strategies agree (3/5=60%, 5/5=100%)")
i_stopLoss      = input.float(0.0, "Stop Loss %", minval=0, maxval=50, step=0.5, group="Risk",
                     tooltip="Trailing stop loss percentage. 0 = disabled.")
i_takeProfit    = input.float(0.0, "Take Profit %", minval=0, maxval=100, step=1.0, group="Risk",
                     tooltip="Take profit percentage. 0 = disabled.")

// --- Display ---
i_showTable     = input.bool(true, "Show Dashboard", group="Display")
i_showSignals   = input.bool(true, "Show Signal Markers", group="Display")

// --- Date Filter ---
i_useDate       = input.bool(false, "Use Date Filter", group="Date Range")
i_startDate     = input.time(timestamp("1985-01-01"), "Start Date", group="Date Range")
i_endDate       = input.time(timestamp("2030-12-31"), "End Date", group="Date Range")

// =============================================================================
// DATE FILTER
// =============================================================================

bool inDateRange = not i_useDate or (time >= i_startDate and time <= i_endDate)

// =============================================================================
// INDICATOR CALCULATIONS
// =============================================================================

// --- S1: Moving Averages ---
float s1_fast = i_s1_useEma ? ta.ema(close, i_s1_fast) : ta.sma(close, i_s1_fast)
float s1_slow = i_s1_useEma ? ta.ema(close, i_s1_slow) : ta.sma(close, i_s1_slow)

// --- S2: Bollinger Bands ---
float s2_basis  = ta.sma(close, i_s2_period)
float s2_dev    = ta.stdev(close, i_s2_period) * i_s2_std
float s2_upper  = s2_basis + s2_dev
float s2_lower  = s2_basis - s2_dev
float s2_pctB   = s2_upper != s2_lower ? (close - s2_lower) / (s2_upper - s2_lower) : 0.5

// --- S3: RSI ---
float s3_rsi = ta.rsi(close, i_s3_period)

// --- S4: MACD ---
float s4_macdLine   = ta.ema(close, i_s4_fast) - ta.ema(close, i_s4_slow)
float s4_signalLine = ta.ema(s4_macdLine, i_s4_signal)
float s4_hist       = s4_macdLine - s4_signalLine

// --- S5: Rate of Change ---
float s5_roc = ta.roc(close, i_s5_period)

// =============================================================================
// SUB-STRATEGY VOTES (-1 = sell, 0 = neutral, +1 = buy)
// =============================================================================

// S1: MA Crossover — bullish when fast > slow
int vote_s1 = 0
if i_s1_enabled and not na(s1_fast) and not na(s1_slow)
    if s1_fast > s1_slow
        vote_s1 := 1
    else if s1_fast < s1_slow
        vote_s1 := -1

// S2: Bollinger — buy at lower band, sell at upper band
int vote_s2 = 0
if i_s2_enabled and not na(s2_pctB)
    if s2_pctB < i_s2_buyPctB
        vote_s2 := 1    // Oversold — buy (mean reversion)
    else if s2_pctB > i_s2_sellPctB
        vote_s2 := -1   // Overbought — sell

// S3: RSI — oversold = buy, overbought = sell
int vote_s3 = 0
if i_s3_enabled and not na(s3_rsi)
    if s3_rsi < i_s3_oversold
        vote_s3 := 1
    else if s3_rsi > i_s3_overbought
        vote_s3 := -1

// S4: MACD — bullish when MACD > signal, bearish when below
int vote_s4 = 0
if i_s4_enabled and not na(s4_macdLine) and not na(s4_signalLine)
    if s4_macdLine > s4_signalLine
        vote_s4 := 1
    else if s4_macdLine < s4_signalLine
        vote_s4 := -1

// S5: ROC — momentum above threshold = buy, below = sell
int vote_s5 = 0
if i_s5_enabled and not na(s5_roc)
    if s5_roc > i_s5_buyThresh
        vote_s5 := 1
    else if s5_roc < i_s5_sellThresh
        vote_s5 := -1

// =============================================================================
// CONSENSUS ENGINE
// =============================================================================

int buyVotes  = (vote_s1 == 1 ? 1 : 0) + (vote_s2 == 1 ? 1 : 0) + (vote_s3 == 1 ? 1 : 0) + (vote_s4 == 1 ? 1 : 0) + (vote_s5 == 1 ? 1 : 0)
int sellVotes = (vote_s1 == -1 ? 1 : 0) + (vote_s2 == -1 ? 1 : 0) + (vote_s3 == -1 ? 1 : 0) + (vote_s4 == -1 ? 1 : 0) + (vote_s5 == -1 ? 1 : 0)

// Count enabled strategies for percentage calculation
int enabledCount = (i_s1_enabled ? 1 : 0) + (i_s2_enabled ? 1 : 0) + (i_s3_enabled ? 1 : 0) + (i_s4_enabled ? 1 : 0) + (i_s5_enabled ? 1 : 0)

// Consensus signal
bool buySignal  = buyVotes >= i_minVotes and inDateRange
bool sellSignal = sellVotes >= i_minVotes and inDateRange

// Conviction-based position sizing
float positionSize = 100.0
if i_posScale and enabledCount > 0
    positionSize := math.max(buyVotes, sellVotes) / enabledCount * 100.0

// =============================================================================
// STRATEGY EXECUTION
// =============================================================================

// Track if we just entered for signal markers
var bool justEnteredLong  = false
var bool justExitedLong   = false

justEnteredLong  := false
justExitedLong   := false

if buySignal and strategy.position_size <= 0
    strategy.entry("MixBuy", strategy.long, qty=strategy.equity * positionSize / 100.0 / close)
    justEnteredLong := true

if sellSignal and strategy.position_size > 0
    strategy.close("MixBuy", comment="MixSell")
    justExitedLong := true

// If outside date range, close everything
if i_useDate and time > i_endDate and strategy.position_size > 0
    strategy.close_all(comment="DateExit")

// --- Stop Loss & Take Profit ---
if i_stopLoss > 0 and strategy.position_size > 0
    strategy.exit("SL/TP", "MixBuy",
         stop=strategy.position_avg_price * (1 - i_stopLoss / 100.0),
         limit=i_takeProfit > 0 ? strategy.position_avg_price * (1 + i_takeProfit / 100.0) : na)
else if i_takeProfit > 0 and strategy.position_size > 0
    strategy.exit("TP", "MixBuy",
         limit=strategy.position_avg_price * (1 + i_takeProfit / 100.0))

// =============================================================================
// OVERLAY PLOTS — Indicators on chart
// =============================================================================

// Moving averages
plot(i_s1_enabled ? s1_fast : na, title="MA Fast", color=color.new(color.blue, 30), linewidth=1)
plot(i_s1_enabled ? s1_slow : na, title="MA Slow", color=color.new(color.red, 30), linewidth=1)

// Bollinger Bands
plot(i_s2_enabled ? s2_upper : na, title="BB Upper", color=color.new(color.gray, 60), linewidth=1)
plot(i_s2_enabled ? s2_lower : na, title="BB Lower", color=color.new(color.gray, 60), linewidth=1)
plot(i_s2_enabled ? s2_basis : na, title="BB Mid", color=color.new(color.gray, 80), linewidth=1, style=plot.style_circles)

// Fill between Bollinger Bands
p_bbU = plot(i_s2_enabled ? s2_upper : na, display=display.none)
p_bbL = plot(i_s2_enabled ? s2_lower : na, display=display.none)
fill(p_bbU, p_bbL, color=color.new(color.blue, 93))

// =============================================================================
// SIGNAL MARKERS
// =============================================================================

plotshape(i_showSignals and justEnteredLong, title="Buy Signal",
     style=shape.triangleup, location=location.belowbar,
     color=color.green, size=size.small, text="BUY")

plotshape(i_showSignals and justExitedLong, title="Sell Signal",
     style=shape.triangledown, location=location.abovebar,
     color=color.red, size=size.small, text="SELL")

// =============================================================================
// BACKGROUND — Conviction coloring
// =============================================================================

color bgColor = na
if buyVotes >= i_minVotes
    bgColor := color.new(color.green, 90 - buyVotes * 5)
else if sellVotes >= i_minVotes
    bgColor := color.new(color.red, 90 - sellVotes * 5)
bgcolor(bgColor, title="Conviction Background")

// =============================================================================
// PERFORMANCE METRICS
// =============================================================================

int totalBars    = bar_index + 1
float tradingYrs = totalBars / 252.0

float totalRet   = strategy.equity > 0 ? (strategy.equity / strategy.initial_capital - 1.0) * 100.0 : 0.0
float cagr       = tradingYrs > 0 ? (math.pow(math.max(strategy.equity, 0.01) / strategy.initial_capital, 1.0 / tradingYrs) - 1.0) * 100.0 : 0.0

var float peakEquity = 0.0
peakEquity := math.max(peakEquity, strategy.equity)
float currentDD = peakEquity > 0 ? (strategy.equity - peakEquity) / peakEquity * 100.0 : 0.0

var float maxDD = 0.0
maxDD := math.min(maxDD, currentDD)

// Win rate from closed trades
float winRate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100.0 : 0.0

// Profit factor
float grossProfit = strategy.grossprofit
float grossLoss   = math.abs(strategy.grossloss)
float profitFactor = grossLoss > 0 ? grossProfit / grossLoss : 0.0

// =============================================================================
// DASHBOARD TABLE
// =============================================================================

if i_showTable and barstate.islast
    var table dash = table.new(position.top_right, 4, 14,
         bgcolor=color.new(color.black, 10),
         border_width=1,
         border_color=color.gray,
         frame_width=2,
         frame_color=color.white)

    // Header
    table.cell(dash, 0, 0, "MIX STRATEGY",    text_color=color.yellow, text_size=size.small, bgcolor=color.new(#1a1a2e, 0), text_halign=text.align_left)
    table.cell(dash, 1, 0, syminfo.tickerid,   text_color=color.aqua,   text_size=size.small, bgcolor=color.new(#1a1a2e, 0), text_halign=text.align_center)
    table.cell(dash, 2, 0, "Vote",             text_color=color.white,  text_size=size.small, bgcolor=color.new(#1a1a2e, 0), text_halign=text.align_center)
    table.cell(dash, 3, 0, "Signal",           text_color=color.white,  text_size=size.small, bgcolor=color.new(#1a1a2e, 0), text_halign=text.align_center)

    // Sub-strategy status
    table.cell(dash, 0, 1, "S1: MA Cross",     text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 1, i_s1_enabled ? "ON" : "OFF", text_color=i_s1_enabled ? color.lime : color.gray, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 2, 1, str.tostring(vote_s1), text_color=vote_s1 > 0 ? color.lime : vote_s1 < 0 ? color.red : color.gray, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 3, 1, vote_s1 > 0 ? "BUY" : vote_s1 < 0 ? "SELL" : "—", text_color=vote_s1 > 0 ? color.lime : vote_s1 < 0 ? color.red : color.gray, text_size=size.small, text_halign=text.align_center)

    table.cell(dash, 0, 2, "S2: Bollinger",    text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 2, i_s2_enabled ? "ON" : "OFF", text_color=i_s2_enabled ? color.lime : color.gray, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 2, 2, str.tostring(vote_s2), text_color=vote_s2 > 0 ? color.lime : vote_s2 < 0 ? color.red : color.gray, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 3, 2, vote_s2 > 0 ? "BUY" : vote_s2 < 0 ? "SELL" : "—", text_color=vote_s2 > 0 ? color.lime : vote_s2 < 0 ? color.red : color.gray, text_size=size.small, text_halign=text.align_center)

    table.cell(dash, 0, 3, "S3: RSI",          text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 3, i_s3_enabled ? "ON" : "OFF", text_color=i_s3_enabled ? color.lime : color.gray, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 2, 3, str.tostring(vote_s3), text_color=vote_s3 > 0 ? color.lime : vote_s3 < 0 ? color.red : color.gray, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 3, 3, vote_s3 > 0 ? "BUY" : vote_s3 < 0 ? "SELL" : "—", text_color=vote_s3 > 0 ? color.lime : vote_s3 < 0 ? color.red : color.gray, text_size=size.small, text_halign=text.align_center)

    table.cell(dash, 0, 4, "S4: MACD",         text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 4, i_s4_enabled ? "ON" : "OFF", text_color=i_s4_enabled ? color.lime : color.gray, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 2, 4, str.tostring(vote_s4), text_color=vote_s4 > 0 ? color.lime : vote_s4 < 0 ? color.red : color.gray, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 3, 4, vote_s4 > 0 ? "BUY" : vote_s4 < 0 ? "SELL" : "—", text_color=vote_s4 > 0 ? color.lime : vote_s4 < 0 ? color.red : color.gray, text_size=size.small, text_halign=text.align_center)

    table.cell(dash, 0, 5, "S5: ROC",          text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 5, i_s5_enabled ? "ON" : "OFF", text_color=i_s5_enabled ? color.lime : color.gray, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 2, 5, str.tostring(vote_s5), text_color=vote_s5 > 0 ? color.lime : vote_s5 < 0 ? color.red : color.gray, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 3, 5, vote_s5 > 0 ? "BUY" : vote_s5 < 0 ? "SELL" : "—", text_color=vote_s5 > 0 ? color.lime : vote_s5 < 0 ? color.red : color.gray, text_size=size.small, text_halign=text.align_center)

    // Divider
    table.cell(dash, 0, 6, "────────────",      text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 6, "────",              text_color=color.gray, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 2, 6, "────",              text_color=color.gray, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 3, 6, "────",              text_color=color.gray, text_size=size.small, text_halign=text.align_center)

    // Consensus
    string consensusStr = str.tostring(buyVotes) + " BUY / " + str.tostring(sellVotes) + " SELL"
    string threshStr    = "Need " + str.tostring(i_minVotes) + "/" + str.tostring(enabledCount)
    table.cell(dash, 0, 7, "Consensus",         text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 7, consensusStr,         text_color=buyVotes >= i_minVotes ? color.lime : sellVotes >= i_minVotes ? color.red : color.orange, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 2, 7, threshStr,            text_color=color.gray, text_size=size.small, text_halign=text.align_center)
    string posStr = strategy.position_size > 0 ? "LONG" : "FLAT"
    table.cell(dash, 3, 7, posStr,               text_color=strategy.position_size > 0 ? color.lime : color.gray, text_size=size.small, text_halign=text.align_center)

    // Performance metrics
    table.cell(dash, 0, 8, "Equity",             text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 8, "$" + str.tostring(strategy.equity, "#,##0"), text_color=strategy.equity >= strategy.initial_capital ? color.lime : color.red, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 2, 8, str.tostring(totalRet, "#,##0.0") + "%", text_color=totalRet >= 0 ? color.lime : color.red, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 3, 8, "Return",             text_color=color.gray, text_size=size.small, text_halign=text.align_center)

    table.cell(dash, 0, 9, "CAGR",               text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 9, str.tostring(cagr, "0.00") + "%", text_color=cagr >= 0 ? color.lime : color.red, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 2, 9, str.tostring(tradingYrs, "0.1") + " yrs", text_color=color.white, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 3, 9, str.tostring(totalBars) + " bars", text_color=color.white, text_size=size.small, text_halign=text.align_center)

    table.cell(dash, 0, 10, "Max Drawdown",      text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 10, str.tostring(maxDD, "0.00") + "%", text_color=color.red, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 2, 10, "Cur: " + str.tostring(currentDD, "0.00") + "%", text_color=currentDD < -5 ? color.red : color.orange, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 3, 10, "",                   text_color=color.gray, text_size=size.small, text_halign=text.align_center)

    table.cell(dash, 0, 11, "Trades",             text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 11, str.tostring(strategy.closedtrades), text_color=color.white, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 2, 11, "Win: " + str.tostring(winRate, "0.0") + "%", text_color=winRate >= 50 ? color.lime : color.orange, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 3, 11, "PF: " + str.tostring(profitFactor, "0.00"), text_color=profitFactor >= 1.0 ? color.lime : color.red, text_size=size.small, text_halign=text.align_center)

    table.cell(dash, 0, 12, "Position Size",     text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 12, str.tostring(positionSize, "0.0") + "%", text_color=color.white, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 2, 12, i_stopLoss > 0 ? "SL: " + str.tostring(i_stopLoss, "0.0") + "%" : "SL: OFF", text_color=i_stopLoss > 0 ? color.orange : color.gray, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 3, 12, i_takeProfit > 0 ? "TP: " + str.tostring(i_takeProfit, "0.0") + "%" : "TP: OFF", text_color=i_takeProfit > 0 ? color.lime : color.gray, text_size=size.small, text_halign=text.align_center)

    // Indicator values
    table.cell(dash, 0, 13, "Indicators",         text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 13, "RSI: " + str.tostring(s3_rsi, "0.0"), text_color=s3_rsi < 30 ? color.lime : s3_rsi > 70 ? color.red : color.white, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 2, 13, "%B: " + str.tostring(s2_pctB, "0.00"), text_color=s2_pctB < 0.2 ? color.lime : s2_pctB > 0.8 ? color.red : color.white, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 3, 13, "ROC: " + str.tostring(s5_roc, "0.0") + "%", text_color=s5_roc > 0 ? color.lime : color.red, text_size=size.small, text_halign=text.align_center)

// =============================================================================
// END
// =============================================================================
