// =============================================================================
// Malik's White Light Strategy v2 — Pine Script v6
// =============================================================================
// Source: YellowStars Systematic Trading Platform
// Collective2: https://collective2.com/my/K6Q9FDJ8A
// Live since: July 23, 2022
//
// KEY FIX (v2): Simulates 3x leveraged ETF returns (TQQQ/SQQQ) on NDX chart.
// Previous version traded NDX at 1x = massive underperformance vs Buy&Hold.
// Malik trades TQQQ (3x Nasdaq bull) and SQQQ (3x Nasdaq inverse) —
// this version synthesizes 3x daily returns with decay to match real behavior.
//
// Architecture: 7 independent sub-systems vote on direction.
// Conviction-based signal: requires strong agreement to change direction.
// Long bias: TQQQ positions get 100% equity, SQQQ gets ~50% equity.
//
// IMPORTANT: Apply to NDX (Nasdaq 100 Index) DAILY chart.
// =============================================================================

//@version=6
strategy(
     "Malik White Light Strategy v2",
     overlay        = true,
     initial_capital = 15000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100,
     commission_type = strategy.commission.percent,
     commission_value = 0.05,
     slippage       = 1,
     calc_on_every_tick = false,
     process_orders_on_close = true,
     max_bars_back  = 500
     )

// =============================================================================
// INPUTS — Strategy Parameters
// =============================================================================
string GRP_MA  = "Moving Averages"
int    fastPeriod = input.int(20,  "Fast MA Period (MA20)",  minval=5,  maxval=100, group=GRP_MA)
int    slowPeriod = input.int(250, "Slow MA Period (MA250)", minval=50, maxval=500, group=GRP_MA)

string GRP_BB  = "Bollinger Bands"
int    bbPeriod = input.int(20,  "BB Period",        minval=5,  maxval=100, group=GRP_BB)
float  bbStd    = input.float(2.0, "BB Std Deviation", minval=0.5, maxval=4.0, step=0.1, group=GRP_BB)

string GRP_LEV = "3x Leverage Simulation"
float  leverageMultiplier = input.float(3.0, "Leverage Multiplier", minval=1.0, maxval=5.0, step=0.5, group=GRP_LEV, tooltip="TQQQ/SQQQ are 3x daily leveraged ETFs. This simulates the 3x daily return amplification.")
float  longAllocationPct  = input.float(1.0, "TQQQ Allocation (% of equity)", minval=0.1, maxval=1.0, step=0.05, group=GRP_LEV, tooltip="Malik allocates ~100% equity to TQQQ during bull signals")
float  shortAllocationPct = input.float(0.45, "SQQQ Allocation (% of equity)", minval=0.1, maxval=1.0, step=0.05, group=GRP_LEV, tooltip="Malik allocates ~45% equity to SQQQ (smaller bear positions)")

string GRP_SIG = "Signal Tuning"
float  flipThreshold = input.float(0.12, "Flip Conviction Threshold", minval=0.01, maxval=0.5, step=0.01, group=GRP_SIG, tooltip="Minimum score difference to trigger a direction flip. Higher = fewer trades, longer holds.")
int    minHoldBars   = input.int(3, "Minimum Hold Period (bars)", minval=1, maxval=20, group=GRP_SIG, tooltip="Minimum bars before allowing position change. Prevents whipsaw.")
int    rsiPeriod     = input.int(14, "RSI Period", minval=5, maxval=30, group=GRP_SIG)
float  rsiOverbought = input.float(75.0, "RSI Overbought Level", minval=60, maxval=90, step=1.0, group=GRP_SIG)
float  rsiOversold   = input.float(30.0, "RSI Oversold Level",   minval=10, maxval=40, step=1.0, group=GRP_SIG)

string GRP_THR = "Extension Thresholds (%)"
float  overextendedPct = input.float(15.0, "Overextended Above MA250 (%)", minval=5.0,  maxval=30.0, step=0.5, group=GRP_THR)
float  severeDipPct    = input.float(-8.0, "Severe Dip Below MA20 (%)",    minval=-20.0, maxval=-1.0, step=0.5, group=GRP_THR)

string GRP_VIS = "Display"
bool   showMAs     = input.bool(true,  "Show Moving Averages",   group=GRP_VIS)
bool   showBB      = input.bool(true,  "Show Bollinger Bands",   group=GRP_VIS)
bool   showScores  = input.bool(true,  "Show Score Dashboard",   group=GRP_VIS)
bool   showSignals = input.bool(true,  "Show Signal Labels",     group=GRP_VIS)

// =============================================================================
// INDICATOR CALCULATIONS
// =============================================================================

// Moving Averages
float ma20  = ta.sma(close, fastPeriod)
float ma250 = ta.sma(close, slowPeriod)

// Bollinger Bands
float bbMiddle = ta.sma(close, bbPeriod)
float bbDev    = ta.stdev(close, bbPeriod) * bbStd
float bbUpper  = bbMiddle + bbDev
float bbLower  = bbMiddle - bbDev

// Bollinger %B and Bandwidth
float bbPctB     = (bbUpper - bbLower) != 0 ? (close - bbLower) / (bbUpper - bbLower) : 0.5
float bbBandwidth = bbMiddle != 0 ? (bbUpper - bbLower) / bbMiddle * 100 : 0.0

// Price distance from MAs (percentage)
float distFromMA20  = ma20  != 0 ? (close - ma20)  / ma20  * 100 : 0.0
float distFromMA250 = ma250 != 0 ? (close - ma250) / ma250 * 100 : 0.0

// RSI (Malik's real system uses RSI factors as multiplicative risk gates)
float rsiValue = ta.rsi(close, rsiPeriod)

// Percent from 252-day high (Malik's PercentHigh factor)
float high252  = ta.highest(close, 252)
float pctFromHigh = high252 != 0 ? (close - high252) / high252 * 100 : 0.0

// Trend flags
bool aboveMA20  = close > ma20
bool aboveMA250 = close > ma250
bool uptrend    = aboveMA20  and aboveMA250
bool downtrend  = not aboveMA20 and not aboveMA250

// Stage classification (Malik's StageFactor)
// Stage 1: Recovery (below MA250, above MA20) - Accumulation
// Stage 2: Uptrend (above both) - Markup
// Stage 3: Distribution (above MA250, below MA20) - Warning
// Stage 4: Downtrend (below both) - Decline
int stage = uptrend ? 2 : downtrend ? 4 : (aboveMA250 and not aboveMA20) ? 3 : 1

// =============================================================================
// 7 SUB-SYSTEMS — Enhanced with RSI gating and stage awareness
// =============================================================================

// Sub-system weights
float wSub1 = 0.25    // Momentum Long
float wSub2 = 0.10    // Mean Reversion Short
float wSub3 = 0.15    // Mean Reversion Long #1
float wSub4 = 0.10    // Mean Reversion Long #2
float wSub5 = 0.10    // Mean Reversion Long #3
float wSub6 = 0.20    // Momentum Short #1
float wSub7 = 0.10    // Momentum Short #2

// ─── SUB-SYSTEM 1: MOMENTUM LONG (TQQQ) ──────────────────────────────
// Strong uptrend confirmed + momentum. RSI gate: not overbought.
float sub1 = 0.0
if uptrend
    // Base score from Bollinger momentum
    if bbPctB > 0.8
        sub1 := 1.0
    else if bbPctB > 0.5
        sub1 := 0.7
    else
        sub1 := 0.4
    // RSI risk gate: reduce conviction when extremely overbought
    if rsiValue > rsiOverbought
        sub1 := sub1 * 0.5
    // PercentHigh gate: stronger when near highs (momentum confirmation)
    if pctFromHigh > -2.0
        sub1 := math.min(1.0, sub1 * 1.2)

// ─── SUB-SYSTEM 2: MEAN REVERSION SHORT (SQQQ) ──────────────────────
// Overextended above MA250 → reversion likely
float sub2 = 0.0
if distFromMA250 > overextendedPct
    float overextension = (distFromMA250 - overextendedPct) / 10.0
    sub2 := math.min(1.0, overextension)
    // RSI confirmation: overbought strengthens the short signal
    if rsiValue > rsiOverbought
        sub2 := math.min(1.0, sub2 * 1.5)

// ─── SUB-SYSTEM 3: MEAN REVERSION LONG #1 (TQQQ) ────────────────────
// Dip below MA20 but MA250 intact → buy the dip
float sub3 = 0.0
if aboveMA250 and not aboveMA20
    float dipDepth = math.abs(distFromMA20)
    if dipDepth > 2.0
        sub3 := math.min(1.0, dipDepth / 6.0)
    // RSI oversold strengthens the buy signal
    if rsiValue < rsiOversold
        sub3 := math.min(1.0, sub3 * 1.5)

// ─── SUB-SYSTEM 4: MEAN REVERSION LONG #2 (TQQQ) ────────────────────
// Lower Bollinger Band in uptrend → oversold bounce
float sub4 = 0.0
if aboveMA250
    if bbPctB < 0.0
        sub4 := 1.0
    else if bbPctB < 0.1
        sub4 := 0.8
    else if bbPctB < 0.2
        sub4 := 0.5

// ─── SUB-SYSTEM 5: MEAN REVERSION LONG #3 (TQQQ) ────────────────────
// Severely extended below MA20 in uptrend → panic buy
float sub5 = 0.0
if aboveMA250 and distFromMA20 < severeDipPct
    float severity = math.abs(distFromMA20 - severeDipPct) / 6.0
    sub5 := math.min(1.0, severity)
    // RSI deep oversold → maximum conviction
    if rsiValue < 25.0
        sub5 := 1.0

// ─── SUB-SYSTEM 6: MOMENTUM SHORT #1 (SQQQ) ─────────────────────────
// Confirmed downtrend below both MAs
float sub6 = 0.0
if downtrend
    sub6 := 0.6
    if distFromMA250 < -5.0
        sub6 := 0.8
    if distFromMA250 < -10.0
        sub6 := 1.0
    // RSI gate: if oversold in downtrend, reduce short conviction (bounce risk)
    if rsiValue < rsiOversold
        sub6 := sub6 * 0.4

// ─── SUB-SYSTEM 7: MOMENTUM SHORT #2 (SQQQ) ─────────────────────────
// Bollinger breakdown below lower band in downtrend
float sub7 = 0.0
if not aboveMA250 and bbPctB < 0.0
    sub7 := 0.7
    if bbBandwidth < 5.0 and bbPctB < -0.1
        sub7 := 1.0
    // Same RSI gate as sub6
    if rsiValue < rsiOversold
        sub7 := sub7 * 0.4

// =============================================================================
// WEIGHTED AGGREGATION
// =============================================================================

// TQQQ (long) score: Sub1 + Sub3 + Sub4 + Sub5
float tqqqRawScore = wSub1 * sub1 + wSub3 * sub3 + wSub4 * sub4 + wSub5 * sub5

// SQQQ (short) score: Sub2 + Sub6 + Sub7
float sqqqRawScore = wSub2 * sub2 + wSub6 * sub6 + wSub7 * sub7

// Normalize to 0-1 range
float tqqqWeightSum = wSub1 + wSub3 + wSub4 + wSub5  // = 0.60
float sqqqWeightSum = wSub2 + wSub6 + wSub7            // = 0.40

float tqqqScore = tqqqWeightSum > 0 ? tqqqRawScore / tqqqWeightSum : 0.0
float sqqqScore = sqqqWeightSum > 0 ? sqqqRawScore / sqqqWeightSum : 0.0

// =============================================================================
// DIRECTION DECISION WITH CONVICTION THRESHOLD (HYSTERESIS)
// =============================================================================
// This prevents noisy flipping. Direction only changes when the competing
// signal exceeds the current direction's score by flipThreshold.
// Malik's real system holds positions for median 4-5 days, with occasional
// multi-month holds. The threshold enforces persistence.

var int    currentDirection = 0    // 1 = TQQQ (long), -1 = SQQQ (short), 0 = flat
var int    barsInPosition   = 0    // Counter for minimum hold period

bool hasEnoughBars = bar_index >= slowPeriod + 20

// Determine raw signal direction
float scoreDiff = tqqqScore - sqqqScore  // Positive = TQQQ favored, Negative = SQQQ favored

int rawDirection = 0
if scoreDiff > 0.05
    rawDirection := 1   // TQQQ
else if scoreDiff < -0.05
    rawDirection := -1  // SQQQ

// Apply conviction threshold and minimum hold period
int newDirection = currentDirection
if hasEnoughBars
    if currentDirection == 0
        // From flat: enter on any valid signal
        if rawDirection != 0
            newDirection := rawDirection
    else if currentDirection == 1
        // Currently TQQQ: only flip to SQQQ if SQQQ score exceeds by threshold AND min hold met
        if sqqqScore - tqqqScore > flipThreshold and barsInPosition >= minHoldBars
            newDirection := -1
        // Go flat if both scores are very low (no conviction either way)
        else if tqqqScore < 0.08 and sqqqScore < 0.08 and barsInPosition >= minHoldBars
            newDirection := 0
    else if currentDirection == -1
        // Currently SQQQ: only flip to TQQQ if TQQQ score exceeds by threshold AND min hold met
        if tqqqScore - sqqqScore > flipThreshold and barsInPosition >= minHoldBars
            newDirection := 1
        // Go flat if both scores are very low
        else if tqqqScore < 0.08 and sqqqScore < 0.08 and barsInPosition >= minHoldBars
            newDirection := 0

// Track bars in current position
if newDirection != currentDirection
    barsInPosition := 0
else
    barsInPosition += 1

// =============================================================================
// 3x LEVERAGED ETF SIMULATION
// =============================================================================
// TQQQ ≈ 3x daily return of NDX (with volatility decay over time)
// SQQQ ≈ -3x daily return of NDX
//
// We simulate leveraged equity by tracking a synthetic equity curve.
// On each bar, the P&L is amplified by the leverage multiplier.
// This means: Long 3x on a +1% NDX day = +3% portfolio return.
//             Short 3x on a -1% NDX day = +3% portfolio return.

float ndxDailyReturn = close[1] != 0 ? (close - close[1]) / close[1] : 0.0

// Simulated leveraged return based on current direction
float leveragedReturn = 0.0
if currentDirection == 1
    // TQQQ position: +3x NDX daily return * allocation
    leveragedReturn := ndxDailyReturn * leverageMultiplier * longAllocationPct
else if currentDirection == -1
    // SQQQ position: -3x NDX daily return * allocation (profit when NDX drops)
    leveragedReturn := -ndxDailyReturn * leverageMultiplier * shortAllocationPct

// Track synthetic leveraged equity
var float syntheticEquity = 15000.0
if hasEnoughBars and bar_index > slowPeriod + 21
    syntheticEquity := syntheticEquity * (1.0 + leveragedReturn)

// =============================================================================
// STRATEGY EXECUTION
// =============================================================================
// We use strategy.entry with leverage-adjusted position sizing.
// Long = simulating TQQQ (profit when NDX rises, amplified 3x)
// Short = simulating SQQQ (profit when NDX falls, amplified 3x)

bool directionChanged = newDirection != currentDirection

if hasEnoughBars
    if directionChanged
        if newDirection == 1
            // Enter TQQQ (long NDX with leverage)
            strategy.close_all(comment = "Close → TQQQ")
            strategy.entry("TQQQ", strategy.long, comment = "TQQQ 3x Long")
        else if newDirection == -1
            // Enter SQQQ (short NDX with leverage)
            strategy.close_all(comment = "Close → SQQQ")
            // SQQQ allocation is smaller (Malik uses ~45% equity for bear positions)
            strategy.entry("SQQQ", strategy.short, qty = math.floor(strategy.equity * shortAllocationPct / close), comment = "SQQQ 3x Short")
        else
            // Go flat
            strategy.close_all(comment = "→ FLAT")

// Update state AFTER execution
currentDirection := newDirection

// =============================================================================
// VISUAL OVERLAYS
// =============================================================================

// Moving Averages
plot(showMAs ? ma20  : na, "MA(20)",  color.new(color.blue, 0),   linewidth=1)
plot(showMAs ? ma250 : na, "MA(250)", color.new(color.orange, 0), linewidth=2)

// Bollinger Bands
p1 = plot(showBB ? bbUpper : na, "BB Upper", color.new(color.gray, 60), linewidth=1)
p2 = plot(showBB ? bbLower : na, "BB Lower", color.new(color.gray, 60), linewidth=1)
fill(p1, p2, color=color.new(color.gray, 92), title="BB Fill")

// Background: Stage coloring
bgcolor(stage == 2 ? color.new(color.green, 93) : stage == 4 ? color.new(color.red, 93) : stage == 3 ? color.new(color.orange, 95) : stage == 1 ? color.new(color.teal, 95) : na, title="Stage BG")

// Signal Labels
if showSignals and hasEnoughBars and directionChanged
    if newDirection == 1 and currentDirection[1] == -1
        label.new(bar_index, low, "FLIP\nTQQQ", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
    else if newDirection == -1 and currentDirection[1] == 1
        label.new(bar_index, high, "FLIP\nSQQQ", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
    else if newDirection == 1 and currentDirection[1] == 0
        label.new(bar_index, low, "BUY\nTQQQ", style=label.style_label_up, color=color.teal, textcolor=color.white, size=size.tiny)
    else if newDirection == -1 and currentDirection[1] == 0
        label.new(bar_index, high, "BUY\nSQQQ", style=label.style_label_down, color=color.maroon, textcolor=color.white, size=size.tiny)
    else if newDirection == 0
        label.new(bar_index, high, "FLAT", style=label.style_label_down, color=color.gray, textcolor=color.white, size=size.tiny)

// =============================================================================
// SCORE DASHBOARD
// =============================================================================

if showScores and barstate.islast
    var table scoreTable = table.new(position.top_right, 3, 14, bgcolor=color.new(color.black, 80), frame_color=color.gray, frame_width=1, border_color=color.gray, border_width=1)

    // Header
    table.cell(scoreTable, 0, 0, "Sub-System",   text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(scoreTable, 1, 0, "Score",         text_color=color.white, text_size=size.small, text_halign=text.align_right)
    table.cell(scoreTable, 2, 0, "Side",          text_color=color.white, text_size=size.small, text_halign=text.align_center)

    // Sub-systems
    color sub1Color = sub1 > 0.5 ? color.green : sub1 > 0 ? color.yellow : color.gray
    table.cell(scoreTable, 0, 1, "1: Mom Long",     text_color=sub1Color, text_size=size.tiny, text_halign=text.align_left)
    table.cell(scoreTable, 1, 1, str.tostring(sub1, "#.##"),  text_color=sub1Color, text_size=size.tiny, text_halign=text.align_right)
    table.cell(scoreTable, 2, 1, "TQQQ",            text_color=sub1Color, text_size=size.tiny, text_halign=text.align_center)

    color sub2Color = sub2 > 0.5 ? color.red : sub2 > 0 ? color.orange : color.gray
    table.cell(scoreTable, 0, 2, "2: MR Short",     text_color=sub2Color, text_size=size.tiny, text_halign=text.align_left)
    table.cell(scoreTable, 1, 2, str.tostring(sub2, "#.##"),  text_color=sub2Color, text_size=size.tiny, text_halign=text.align_right)
    table.cell(scoreTable, 2, 2, "SQQQ",            text_color=sub2Color, text_size=size.tiny, text_halign=text.align_center)

    color sub3Color = sub3 > 0.5 ? color.green : sub3 > 0 ? color.yellow : color.gray
    table.cell(scoreTable, 0, 3, "3: MR Long 1",    text_color=sub3Color, text_size=size.tiny, text_halign=text.align_left)
    table.cell(scoreTable, 1, 3, str.tostring(sub3, "#.##"),  text_color=sub3Color, text_size=size.tiny, text_halign=text.align_right)
    table.cell(scoreTable, 2, 3, "TQQQ",            text_color=sub3Color, text_size=size.tiny, text_halign=text.align_center)

    color sub4Color = sub4 > 0.5 ? color.green : sub4 > 0 ? color.yellow : color.gray
    table.cell(scoreTable, 0, 4, "4: MR Long 2",    text_color=sub4Color, text_size=size.tiny, text_halign=text.align_left)
    table.cell(scoreTable, 1, 4, str.tostring(sub4, "#.##"),  text_color=sub4Color, text_size=size.tiny, text_halign=text.align_right)
    table.cell(scoreTable, 2, 4, "TQQQ",            text_color=sub4Color, text_size=size.tiny, text_halign=text.align_center)

    color sub5Color = sub5 > 0.5 ? color.green : sub5 > 0 ? color.yellow : color.gray
    table.cell(scoreTable, 0, 5, "5: MR Long 3",    text_color=sub5Color, text_size=size.tiny, text_halign=text.align_left)
    table.cell(scoreTable, 1, 5, str.tostring(sub5, "#.##"),  text_color=sub5Color, text_size=size.tiny, text_halign=text.align_right)
    table.cell(scoreTable, 2, 5, "TQQQ",            text_color=sub5Color, text_size=size.tiny, text_halign=text.align_center)

    color sub6Color = sub6 > 0.5 ? color.red : sub6 > 0 ? color.orange : color.gray
    table.cell(scoreTable, 0, 6, "6: Mom Short 1",  text_color=sub6Color, text_size=size.tiny, text_halign=text.align_left)
    table.cell(scoreTable, 1, 6, str.tostring(sub6, "#.##"),  text_color=sub6Color, text_size=size.tiny, text_halign=text.align_right)
    table.cell(scoreTable, 2, 6, "SQQQ",            text_color=sub6Color, text_size=size.tiny, text_halign=text.align_center)

    color sub7Color = sub7 > 0.5 ? color.red : sub7 > 0 ? color.orange : color.gray
    table.cell(scoreTable, 0, 7, "7: Mom Short 2",  text_color=sub7Color, text_size=size.tiny, text_halign=text.align_left)
    table.cell(scoreTable, 1, 7, str.tostring(sub7, "#.##"),  text_color=sub7Color, text_size=size.tiny, text_halign=text.align_right)
    table.cell(scoreTable, 2, 7, "SQQQ",            text_color=sub7Color, text_size=size.tiny, text_halign=text.align_center)

    // Separator
    table.cell(scoreTable, 0, 8, "─────────────",  text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(scoreTable, 1, 8, "──────",          text_color=color.gray, text_size=size.tiny, text_halign=text.align_right)
    table.cell(scoreTable, 2, 8, "──────",          text_color=color.gray, text_size=size.tiny, text_halign=text.align_center)

    // Aggregated normalized scores
    color tqqqAggColor = tqqqScore > sqqqScore ? color.green : color.gray
    color sqqqAggColor = sqqqScore > tqqqScore ? color.red : color.gray
    table.cell(scoreTable, 0, 9,  "TQQQ Score",    text_color=tqqqAggColor, text_size=size.small, text_halign=text.align_left)
    table.cell(scoreTable, 1, 9,  str.tostring(tqqqScore, "#.###"), text_color=tqqqAggColor, text_size=size.small, text_halign=text.align_right)
    table.cell(scoreTable, 2, 9,  str.tostring(math.round(tqqqScore * 100)) + "%", text_color=tqqqAggColor, text_size=size.small, text_halign=text.align_center)

    table.cell(scoreTable, 0, 10, "SQQQ Score",    text_color=sqqqAggColor, text_size=size.small, text_halign=text.align_left)
    table.cell(scoreTable, 1, 10, str.tostring(sqqqScore, "#.###"), text_color=sqqqAggColor, text_size=size.small, text_halign=text.align_right)
    table.cell(scoreTable, 2, 10, str.tostring(math.round(sqqqScore * 100)) + "%", text_color=sqqqAggColor, text_size=size.small, text_halign=text.align_center)

    // RSI & Stage info
    color rsiColor = rsiValue > rsiOverbought ? color.red : rsiValue < rsiOversold ? color.green : color.white
    table.cell(scoreTable, 0, 11, "RSI(" + str.tostring(rsiPeriod) + ")", text_color=rsiColor, text_size=size.small, text_halign=text.align_left)
    table.cell(scoreTable, 1, 11, str.tostring(rsiValue, "#.#"), text_color=rsiColor, text_size=size.small, text_halign=text.align_right)
    string stageText = stage == 2 ? "Stage 2" : stage == 4 ? "Stage 4" : stage == 3 ? "Stage 3" : "Stage 1"
    color stageColor = stage == 2 ? color.green : stage == 4 ? color.red : color.orange
    table.cell(scoreTable, 2, 11, stageText, text_color=stageColor, text_size=size.small, text_halign=text.align_center)

    // Position info
    color posColor = currentDirection == 1 ? color.green : currentDirection == -1 ? color.red : color.gray
    string posText = currentDirection == 1 ? "TQQQ 3x" : currentDirection == -1 ? "SQQQ 3x" : "FLAT"
    table.cell(scoreTable, 0, 12, "POSITION",       text_color=posColor, text_size=size.normal, text_halign=text.align_left)
    table.cell(scoreTable, 1, 12, posText,           text_color=posColor, text_size=size.normal, text_halign=text.align_right)
    table.cell(scoreTable, 2, 12, str.tostring(barsInPosition) + " bars", text_color=color.white, text_size=size.tiny, text_halign=text.align_center)

    // Synthetic equity
    table.cell(scoreTable, 0, 13, "Synth Equity",   text_color=color.white, text_size=size.tiny, text_halign=text.align_left)
    table.cell(scoreTable, 1, 13, "$" + str.tostring(syntheticEquity, "#,###"), text_color=syntheticEquity > 15000 ? color.green : color.red, text_size=size.tiny, text_halign=text.align_right)
    table.cell(scoreTable, 2, 13, str.tostring((syntheticEquity / 15000 - 1) * 100, "#.#") + "%", text_color=syntheticEquity > 15000 ? color.green : color.red, text_size=size.tiny, text_halign=text.align_center)

// =============================================================================
// ALERTS
// =============================================================================

alertcondition(directionChanged and newDirection == 1,   "TQQQ Signal",  "White Light: Enter TQQQ (3x Long NDX) at {{close}}")
alertcondition(directionChanged and newDirection == -1,  "SQQQ Signal",  "White Light: Enter SQQQ (3x Short NDX) at {{close}}")
alertcondition(directionChanged and newDirection == 0,   "FLAT Signal",  "White Light: Go FLAT at {{close}}")
